# Copy this file to ".env" and put your real values there.
# The ".env" file is ignored by git, so your key is never committed.
# Placeholder values like the one below are treated as "not set".

# Required for Gemini answers. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional. Model ID to use. Check https://ai.google.dev/gemini-api/docs/models for current names.
# GEMINI_MODEL=gemini-3.8-flash

# Optional tuning
# GEMINI_TIMEOUT_SECONDS=25     # give up on a request after this many seconds (1-120)
# GEMINI_MAX_RETRIES=1          # extra attempts for temporary errors only (0-3)
# GEMINI_API=auto               # auto | interactions | generate_content (escape hatch if the SDK changes)
# RAG_MIN_SCORE=0.08            # how similar a passage must be to count as relevant (0-1)
